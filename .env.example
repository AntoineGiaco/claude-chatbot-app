# Configuration exemple pour l'application
# Copiez ce fichier en .env et remplissez les valeurs

# ========== OLLAMA ==========
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ========== GOOGLE DRIVE ==========
# Laissez vide si vous voulez utiliser OAuth (recommandé)
# Sinon, configurez credentials.json

# ========== FLASK ==========
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=5000

# ========== BASE DE CONNAISSANCE ==========
KNOWLEDGE_FOLDER=IA-Documents
UPDATE_INTERVAL=3600  # Secondes
